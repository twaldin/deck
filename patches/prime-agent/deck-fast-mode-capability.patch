From 96ee5bce0af2f30fb07ff8b8bc3bcb6a9a581b32 Mon Sep 17 00:00:00 2001
From: twaldin <timothy@waldin.net>
Date: Thu, 6 Aug 2026 00:35:50 -0700
Subject: [PATCH] fix fast mode for capable custom providers

---
 packages/ai/src/models.ts                     | 10 ++--
 .../ai/src/providers/openai-completions.ts    |  4 ++
 packages/ai/src/types.ts                      |  5 ++
 packages/ai/test/fast-mode.test.ts            | 47 ++++++++++++++++++-
 .../coding-agent/src/core/model-registry.ts   |  6 +++
 5 files changed, 65 insertions(+), 7 deletions(-)

diff --git a/packages/ai/src/models.ts b/packages/ai/src/models.ts
index fc7ba59b..553483a0 100644
--- a/packages/ai/src/models.ts
+++ b/packages/ai/src/models.ts
@@ -37,11 +37,11 @@ export function getModels<TProvider extends KnownProvider>(
 }
 
 export function supportsFastMode<TApi extends Api>(model: Model<TApi>): boolean {
-	return (
-		model.provider === "openai-codex" &&
-		model.api === "openai-codex-responses" &&
-		(model.id === "gpt-5.4" || model.id === "gpt-5.5" || model.id === "gpt-5.6" || model.id.startsWith("gpt-5.6-"))
-	);
+	const supportedModel =
+		model.id === "gpt-5.4" || model.id === "gpt-5.5" || model.id === "gpt-5.6" || model.id.startsWith("gpt-5.6-");
+	if (!supportedModel) return false;
+	if (model.provider === "openai-codex" && model.api === "openai-codex-responses") return true;
+	return model.api === "openai-completions" && model.supportsFastMode === true;
 }
 
 export interface CostOverrides {
diff --git a/packages/ai/src/providers/openai-completions.ts b/packages/ai/src/providers/openai-completions.ts
index 155c5a07..675fab29 100644
--- a/packages/ai/src/providers/openai-completions.ts
+++ b/packages/ai/src/providers/openai-completions.ts
@@ -523,6 +523,10 @@ function buildParams(
 		prompt_cache_retention: cacheRetention === "long" && compat.supportsLongCacheRetention ? "24h" : undefined,
 	};
 
+	if (model.supportsFastMode && options?.serviceTier === "priority") {
+		(params as typeof params & { service_tier?: "priority" }).service_tier = "priority";
+	}
+
 	if (compat.supportsUsageInStreaming !== false) {
 		(params as any).stream_options = { include_usage: true };
 	}
diff --git a/packages/ai/src/types.ts b/packages/ai/src/types.ts
index f38c99c5..ad763040 100644
--- a/packages/ai/src/types.ts
+++ b/packages/ai/src/types.ts
@@ -443,6 +443,11 @@ export interface Model<TApi extends Api> {
 	provider: Provider;
 	baseUrl: string;
 	reasoning: boolean;
+	/**
+	 * Whether this route realizes ChatGPT Fast mode via `service_tier: "priority"`.
+	 * Custom providers must opt in explicitly; API-key Priority processing is not Fast mode.
+	 */
+	supportsFastMode?: boolean;
 	/**
 	 * Maps pi thinking levels to provider/model-specific values.
 	 * Missing keys use provider defaults. null marks a level as unsupported.
diff --git a/packages/ai/test/fast-mode.test.ts b/packages/ai/test/fast-mode.test.ts
index 3f2185ec..a84ce31e 100644
--- a/packages/ai/test/fast-mode.test.ts
+++ b/packages/ai/test/fast-mode.test.ts
@@ -1,9 +1,10 @@
 import { describe, expect, it } from "vitest";
 import { supportsFastMode } from "../src/models.js";
+import { streamOpenAICompletions } from "../src/providers/openai-completions.js";
 import { buildBaseOptions } from "../src/providers/simple-options.js";
-import type { Api, Model } from "../src/types.js";
+import type { Api, Context, Model } from "../src/types.js";
 
-function model(provider: string, id: string, api: Api): Model<Api> {
+function model(provider: string, id: string, api: Api, supportsFastMode?: boolean): Model<Api> {
 	return {
 		id,
 		name: id,
@@ -15,6 +16,7 @@ function model(provider: string, id: string, api: Api): Model<Api> {
 		cost: { input: 1, output: 1, cacheRead: 0, cacheWrite: 0 },
 		contextWindow: 1000,
 		maxTokens: 100,
+		supportsFastMode,
 	};
 }
 
@@ -23,14 +25,55 @@ describe("Fast mode", () => {
 		expect(supportsFastMode(model("openai-codex", id, "openai-codex-responses"))).toBe(true);
 	});
 
+	it.each(["gpt-5.4", "gpt-5.5", "gpt-5.6-luna"])("supports %s through an opted-in compatible route", (id) => {
+		expect(supportsFastMode(model("deck", id, "openai-completions", true))).toBe(true);
+	});
+
 	it("rejects unsupported models and API-key providers", () => {
 		expect(supportsFastMode(model("openai-codex", "gpt-5.3-codex", "openai-codex-responses"))).toBe(false);
 		expect(supportsFastMode(model("openai-codex", "gpt-5.4-mini", "openai-codex-responses"))).toBe(false);
 		expect(supportsFastMode(model("openai", "gpt-5.5", "openai-responses"))).toBe(false);
+		expect(supportsFastMode(model("deck", "gpt-5.5", "openai-completions"))).toBe(false);
 	});
 
 	it("forwards priority through simple stream options", () => {
 		const testModel = model("openai-codex", "gpt-5.5", "openai-codex-responses");
 		expect(buildBaseOptions(testModel, { serviceTier: "priority" }).serviceTier).toBe("priority");
 	});
+
+	it("serializes priority for an opted-in OpenAI-compatible route", async () => {
+		const testModel = model("deck", "gpt-5.6-sol", "openai-completions", true) as Model<"openai-completions">;
+		const context: Context = { systemPrompt: "test", messages: [] };
+		let payload: Record<string, unknown> | undefined;
+		const stream = streamOpenAICompletions(testModel, context, {
+			apiKey: "test",
+			serviceTier: "priority",
+			signal: AbortSignal.abort(),
+			onPayload(value) {
+				payload = value as Record<string, unknown>;
+			},
+		});
+		for await (const event of stream) {
+			if (event.type === "error") break;
+		}
+		expect(payload?.service_tier).toBe("priority");
+
+		const unsupportedPayloads: Array<Record<string, unknown>> = [];
+		const unsupportedStream = streamOpenAICompletions(
+			model("deck", "gpt-5.6-sol", "openai-completions") as Model<"openai-completions">,
+			context,
+			{
+				apiKey: "test",
+				serviceTier: "priority",
+				signal: AbortSignal.abort(),
+				onPayload(value) {
+					unsupportedPayloads.push(value as Record<string, unknown>);
+				},
+			},
+		);
+		for await (const event of unsupportedStream) {
+			if (event.type === "error") break;
+		}
+		expect(unsupportedPayloads[0]?.service_tier).toBeUndefined();
+	});
 });
